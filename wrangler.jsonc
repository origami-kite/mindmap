{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mindmap-collab",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "Y_DURABLE_OBJECTS",
        "class_name": "YDurableObjects"
      }
    ]
  },
  "exports": {
    "YDurableObjects": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
